# Arena 运行时配置。真实密钥建议在 /setups 页面录入（写入 data/secrets.json, 0600）。
# 这里只放非敏感默认值。

# SQLite 文件位置
ARENA_DB=data/arena.db

# 单次调用总时限（毫秒）。只是计费兜底，不是「想了多久」的判据；0 = 不限。
# 单个模型可以在 /setups 里单独设 1–120 分钟（落到 models.call_timeout_ms）。
ARENA_CALL_TIMEOUT_MS=1800000

# 连续这么久没有任何新内容 → 判定卡死并中止本次调用（毫秒）。
# 注意：SSE 心跳、空 delta、只带 usage 的帧都算「有字节」，不会让计时器续命失败。
ARENA_STALL_MS=180000

# 被静默剪断时，如果这一趟一个字都没收到，重开几次（0 = 关闭）。
# 已经吐过内容再断的不重试——那是把同一段思考计费两遍。
ARENA_STALL_RETRY=1

# 思考流内存兜底（字符）。只防真死循环；0 = 关闭。
ARENA_MAX_THINKING_CHARS=2000000

# 直播推送节奏（毫秒）：多久把攒下的思考推给观众一次。这是观感的主要旋钮。
ARENA_FLUSH_MS=80
# 单包上限（字符）：一次 delta 太大就切片，避免一个巨型事件。
ARENA_FLUSH_MAX_CHARS=4096
# 单次调用的推送条数预算；超过后只把间隔翻倍，不加大块。
ARENA_FLUSH_BUDGET=600
# 退避上限（毫秒）：再慢的流也保持这个节奏，绝不静默。
ARENA_FLUSH_MAX_INTERVAL_MS=1000

# 已退役：不再用「多少秒没提交」推断跑偏，设了也不生效。
# ARENA_NO_SUBMIT_MS=

# models.dev 能力目录（思考档位/上下文/价格）。默认官方地址，进程内缓存 6 小时。
# MODELS_DEV_URL=https://models.dev/api.json

# 未在 UI 配置时用作兜底（可选）
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# MOONSHOT_API_KEY=
