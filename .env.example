# Arena 运行时配置。真实密钥建议在 /setups 页面录入（写入 data/secrets.json, 0600）。
# 这里只放非敏感默认值。

# SQLite 文件位置
ARENA_DB=data/arena.db

# 单次模型调用硬超时（毫秒）。超时该方本轮弃权。
ARENA_CALL_TIMEOUT_MS=180000

# 超过这么久还没开始写提交块，判定为跑偏并截断。
ARENA_NO_SUBMIT_MS=150000

# 单次调用的思考流内存上限（字符），纯兜底。
ARENA_MAX_THINKING_CHARS=60000

# models.dev 能力目录（思考档位/上下文/价格）。默认官方地址，进程内缓存 6 小时。
# MODELS_DEV_URL=https://models.dev/api.json

# 未在 UI 配置时用作兜底（可选）
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# MOONSHOT_API_KEY=
