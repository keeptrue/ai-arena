{
  "name": "ai-arena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run export:build && next dev -p 3099",
    "build": "bun run export:build && next build",
    "start": "bun run export:build && next start -p 3099",
    "export:build": "bun run scripts/build-export-assets.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:migrate": "bun run scripts/migrate.ts",
    "db:seed": "bun run scripts/seed.ts",
    "db:rulesets": "bun run scripts/refresh-rulesets.ts",
    "db:repair": "bun run scripts/repair-board.ts"
  },
  "dependencies": {
    "next": "^16.4.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/bun": "^1.2.23",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3"
  }
}
